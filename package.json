{
  "name": "dsh-cua-preview",
  "version": "0.1.0",
  "description": "DSH plugin: browser automation whose click and submit actions are gated by a DSH approval, with the current screen captured as a screenshot the user reviews before the action runs.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "default": "./src/client/browser.js"
    },
    "./browser": "./src/browser.js",
    "./approval-broker": "./src/approval-broker.js",
    "./tools": "./src/tools.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffyfox/dsh-cua-preview.git"
  },
  "bugs": {
    "url": "https://github.com/ffyfox/dsh-cua-preview/issues"
  },
  "homepage": "https://github.com/ffyfox/dsh-cua-preview#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "cordis-plugin",
    "plugin",
    "browser-automation",
    "puppeteer",
    "computer-use",
    "cua",
    "screenshot",
    "approval"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/verify-client-bundle.mjs && node examples/run-acceptance.mjs && node examples/run-real-dsh-load.mjs",
    "test:client": "node scripts/verify-client-bundle.mjs",
    "test:acceptance": "node examples/run-acceptance.mjs",
    "test:real-load": "node examples/run-real-dsh-load.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment-local": "0.1.5-rc.3",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.3",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.1.5-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.3",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
